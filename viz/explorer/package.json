{
  "name": "nyc-budget-explorer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Static in-browser explorer for the NYC Council budget data in BetaNYC/New-York-City-Budget, built from the same index as @betanyc/nyc-budget-mcp and queried with DuckDB-WASM over Parquet.",
  "license": "MIT",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:parity",
    "test:unit": "vitest run",
    "test:parity": "node --test test/parity.test.mjs",
    "site": "node scripts/assemble-site.mjs"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@duckdb/node-api": "~1.5.6-r.2",
    "@vitejs/plugin-react": "^5.2.0",
    "better-sqlite3": "^12.10.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12"
  }
}
