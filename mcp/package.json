{
  "name": "@betanyc/nyc-budget-mcp",
  "version": "2.0.1",
  "description": "MCP server for BetaNYC's New York City Budget data, built only from structured sources: the NYC Council's expense funding disclosure workbooks (FY2009, FY2011–FY2027) and its capital designations (Council workbooks and NYC Open Data, FY2015–FY2027, FY2018 missing), with a by-budget-line comparison to OMB's adopted capital budget.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nyc",
    "new-york-city",
    "civic-tech",
    "open-data",
    "budget",
    "discretionary-funding",
    "capital-budget",
    "expense-disclosure",
    "betanyc"
  ],
  "license": "MIT",
  "author": "BetaNYC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetaNYC/New-York-City-Budget.git",
    "directory": "mcp"
  },
  "homepage": "https://github.com/BetaNYC/New-York-City-Budget/tree/main/mcp#readme",
  "bugs": {
    "url": "https://github.com/BetaNYC/New-York-City-Budget/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "nyc-budget-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "data/budget.db"
  ],
  "scripts": {
    "build": "tsc",
    "build-index": "node scripts/build-index.mjs --spreadsheet-only",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "node scripts/prepare.mjs",
    "pretest": "npm run build && npm run build-index && node scripts/build-pdf-release.mjs --out .pdf-test/release --keep-full",
    "test": "node --test test/*.test.js",
    "build-pdf-release": "node scripts/build-pdf-release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^12.10.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "csv-parse": "^5.5.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22"
  }
}
